      "id": "r5",
      "stage": "review",
      "qtype": "numeric",
      "prompt": "X가 1, 2, 3을 각각 1/3의 확률로 가질 때 V(X)는? (기약분수로)",
      "answer": "2/3",
      "answer_format": "fraction",
      "tolerance": 0,
      "hint": "E(X²) − {E(X)}²",
      "explanation": "E(X) = 2, E(X²) = (1 + 4 + 9)/3 = 14/3\nV(X) = 14/3 − 4\n= 2/3",
      "source_lesson": "c5-ch05-l02"
    },
    {
