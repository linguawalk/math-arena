      "answer": "1/2",
      "answer_format": "fraction",
      "tolerance": 0,
      "hint": null,
      "explanation": ""
    },
    {
      "type": "question",
      "id": "q4",
      "stage": "discover",
      "qtype": "numeric",
      "prompt": "주사위 한 개의 눈의 분산은? (기약분수로)",
