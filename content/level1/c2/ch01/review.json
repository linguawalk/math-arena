      "qtype": "numeric",
      "prompt": "두 점 (−1, 3), (2, 7) 사이의 거리는?",
      "answer": "5",
      "answer_format": "integer",
      "tolerance": 0,
      "hint": "가로 차이와 세로 차이를 구하세요.",
      "explanation": "가로 차이 3, 세로 차이 4\n두 점 사이의 거리 공식: √(9 + 16)\n= 5",
      "source_lesson": "c2-ch01-l01"
    },
    {
