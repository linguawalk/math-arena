      "id": "r7",
      "stage": "review",
      "qtype": "numeric",
      "prompt": "세 점 (0, 1), (2, 5), (4, a)가 한 직선 위에 있을 때 a의 값은?",
      "answer": "9",
      "answer_format": "integer",
      "tolerance": 0,
      "hint": "기울기가 같아야 합니다.",
      "explanation": "(0, 1), (2, 5)의 기울기 2\n(0, 1), (4, a)의 기울기 (a − 1)/4 = 2\na = 9",
      "source_lesson": "c2-ch01-l03"
