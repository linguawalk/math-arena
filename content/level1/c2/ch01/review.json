    {
      "type": "question",
      "id": "r10",
      "stage": "review",
      "qtype": "numeric",
      "prompt": "두 직선 y = ax + 1, y = (a − 2)x + 3이 수직일 때 a의 값은?",
      "answer": "1",
      "answer_format": "integer",
      "tolerance": 0,
      "hint": "기울기의 곱을 −1로 놓으세요.",
      "explanation": "수직이면 기울기의 곱이 −1: a(a − 2) = −1\na² − 2a + 1 = (a − 1)² = 0\na = 1",
