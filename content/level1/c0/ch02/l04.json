    {
      "type": "explain",
      "id": "s2",
      "stage": "discover",
      "title": "곱셈공식",
      "body": [
        "(a + b)² = a² + 2ab + b²,  (a − b)² = a² − 2ab + b²",
        "(a + b)(a − b) = a² − b²",
        "(x + a)(x + b) = x² + (a + b)x + ab"
      ]
    },
    {
      "type": "example",
      "id": "e1",
