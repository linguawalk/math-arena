      "problem": "(2x + 3)²을 전개하세요.",
      "steps": [
        "(a + b)² = a² + 2ab + b²에서 a = 2x, b = 3",
        "a² = 4x²",
        "2ab = 2 × 2x × 3 = 12x",
        "b² = 9"
      ],
      "answer": "4x² + 12x + 9"
    },
